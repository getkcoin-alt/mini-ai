APP_ENV=development
LOG_LEVEL=INFO
MINI_ADMIN_API_KEY=
MINI_DATA_DIR=./data
MINI_PUBLIC_URL=http://127.0.0.1:8000

# Existing OpenAI-compatible provider (Groq/OpenRouter/OpenAI/etc.)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=groq/compound-mini
LLM_REQUIRED=false

# Vault Zeta Streamable HTTP MCP endpoint. Keep the trailing slash.
VAULT_MCP_URL=http://127.0.0.1:8000/mcp/
VAULT_API_KEY=
VAULT_MCP_REQUIRED=false
VAULT_TIMEOUT_SECONDS=12
