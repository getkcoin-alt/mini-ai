# All variables are read on the PRIVATE voice worker, never the browser.
# Backend calls from Vercel require a stable HTTPS worker URL and a random server token.
MINI_WORKER_TOKEN=
MINI_VOICE_DATA_DIR=
MINI_OLLAMA_URL=http://127.0.0.1:11434
MINI_OLLAMA_MODEL=llama3.2:1b
MINI_WHISPER_MODEL=tiny.en
MINI_TTS_MODE=auto
MINI_CPU_THREADS=2
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
# Multilingual reference models are experimental on this CPU-only host.
MINI_MAX_REPLY_CHARS=450

# Vercel project's backend-only variables for REMOTE mobile use:
# MINI_WORKER_URL=https://your-private-voice-worker.example.com
# MINI_WORKER_TOKEN=<the same token as worker>
# GOOGLE_CLIENT_ID=<google auth public web client id>
# MINI_OWNER_EMAIL=karnveer@scriza.in
# MINI_SESSION_SECRET=<random 32+ char string>
